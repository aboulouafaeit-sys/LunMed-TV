<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="320dp"
    android:height="180dp"
    android:viewportWidth="320"
    android:viewportHeight="180">

    <!-- Canvas Background -->
    <path
        android:fillColor="#07090E"
        android:pathData="M0,0h320v180h-320z" />

    <!-- Ambient Subtle Amber Radial Glow -->
    <path
        android:pathData="M160,90m-130,0a130,130 0,1 1,260 0a130,130 0,1 1,-260 0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="160"
                android:centerY="90"
                android:gradientRadius="130"
                android:type="radial">
                <item android:color="#33E5C17B" android:offset="0.0" />
                <item android:color="#10E5C17B" android:offset="0.5" />
                <item android:color="#0007090E" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Outer Cinematic Gold Border Frame -->
    <path
        android:strokeWidth="1.2"
        android:pathData="M12,12 L308,12 L308,168 L12,168 Z">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="12"
                android:startY="12"
                android:endX="308"
                android:endY="168"
                android:type="linear">
                <item android:color="#4DE5C17B" android:offset="0.0" />
                <item android:color="#14FFFFFF" android:offset="0.5" />
                <item android:color="#4DE5C17B" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Left Screen Frame: Monogram "L" -->
    <!-- Gold Shadow -->
    <path
        android:fillColor="#5A4315"
        android:pathData="M78,40 L108,24 L108,124 L148,124 L134,146 L78,146 Z" />

    <!-- Gold Beveled Monogram -->
    <path
        android:pathData="M76,38 L106,22 L106,122 L146,122 L132,144 L76,144 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="76"
                android:startY="22"
                android:endX="146"
                android:endY="144"
                android:type="linear">
                <item android:color="#FFF8E7" android:offset="0.0" />
                <item android:color="#E5C17B" android:offset="0.4" />
                <item android:color="#C49A45" android:offset="0.75" />
                <item android:color="#8A651E" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Inner Obsidian Inset -->
    <path
        android:fillColor="#0A0E17"
        android:pathData="M84,48 L100,38 L100,114 L132,114 L122,136 L84,136 Z" />

    <!-- Specular Highlight Glaze -->
    <path
        android:pathData="M84,48 L100,38 L100,90 L84,104 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="84"
                android:startY="38"
                android:endX="100"
                android:endY="104"
                android:type="linear">
                <item android:color="#4DFFFFFF" android:offset="0.0" />
                <item android:color="#00FFFFFF" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Right Section: Typography & Brand -->
    <!-- "LUNMED" Letters in pure vector paths for 100% sharp rendering -->
    <!-- L -->
    <path
        android:fillColor="#F3F5F8"
        android:pathData="M165,68 L170,68 L170,89 L182,89 L182,93 L165,93 Z" />
    <!-- U -->
    <path
        android:fillColor="#F3F5F8"
        android:pathData="M188,68 L193,68 L193,85 C193,89 195,91 199,91 C203,91 205,89 205,85 L205,68 L210,68 L210,85 C210,92 205,94 199,94 C193,94 188,92 188,85 Z" />
    <!-- N -->
    <path
        android:fillColor="#F3F5F8"
        android:pathData="M216,68 L221,68 L232,87 L232,68 L237,68 L237,93 L232,93 L221,74 L221,93 L216,93 Z" />
    <!-- M -->
    <path
        android:fillColor="#F3F5F8"
        android:pathData="M243,68 L249,68 L254,82 L259,68 L265,68 L265,93 L260,93 L260,76 L256,87 L252,87 L248,76 L248,93 L243,93 Z" />
    <!-- E -->
    <path
        android:fillColor="#F3F5F8"
        android:pathData="M271,68 L286,68 L286,72 L276,72 L276,78 L284,78 L284,82 L276,82 L276,89 L286,89 L286,93 L271,93 Z" />
    <!-- D -->
    <path
        android:fillColor="#F3F5F8"
        android:pathData="M292,68 L301,68 C307,68 311,72 311,80.5 C311,89 307,93 301,93 L292,93 Z M297,72 L297,89 L301,89 C304,89 306,86 306,80.5 C306,75 304,72 301,72 Z" />

    <!-- TV Luxury Gold Pill Tag -->
    <path
        android:fillColor="#171E2E"
        android:pathData="M165,106 C165,102 168,99 172,99 L206,99 C210,99 213,102 213,106 L213,118 C213,122 210,125 206,125 L172,125 C168,125 165,122 165,118 Z" />

    <path
        android:strokeColor="#E5C17B"
        android:strokeWidth="1"
        android:pathData="M165,106 C165,102 168,99 172,99 L206,99 C210,99 213,102 213,106 L213,118 C213,122 210,125 206,125 L172,125 C168,125 165,122 165,118 Z" />

    <!-- T in pill -->
    <path
        android:fillColor="#E5C17B"
        android:pathData="M176,105 L186,105 L186,107.5 L182.5,107.5 L182.5,119 L179.5,119 L179.5,107.5 L176,107.5 Z" />
    <!-- V in pill -->
    <path
        android:fillColor="#E5C17B"
        android:pathData="M191,105 L194.5,105 L198,115.5 L201.5,105 L205,105 L199.8,119 L196.2,119 Z" />

    <!-- Subtitle: CINEMATIC ENTERTAINMENT -->
    <!-- Gold accent underline bar -->
    <path
        android:pathData="M220,112 L308,112 L306,113.5 L220,113.5 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="220"
                android:startY="112"
                android:endX="308"
                android:endY="113.5"
                android:type="linear">
                <item android:color="#E5C17B" android:offset="0.0" />
                <item android:color="#00E5C17B" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
